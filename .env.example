# Koyeb supplies PORT automatically.
PORT=8080

# Hosted SQLite-compatible database. The URL is public configuration.
TURSO_DATABASE_URL=libsql://xclone-damoon.aws-ap-northeast-1.turso.io

# Put the real value in a Koyeb Secret. Never commit it.
TURSO_AUTH_TOKEN=replace-with-a-new-rotated-token

# This variable belongs on desktop clients, not on the Koyeb backend.
XCLONE_SERVER_URL=https://YOUR-SERVICE-YOUR-ORG.koyeb.app

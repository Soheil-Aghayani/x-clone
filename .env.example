# Render supplies PORT automatically in production. This value is useful locally.
PORT=8080

# Hosted SQLite-compatible database. The URL is public configuration.
TURSO_DATABASE_URL=libsql://xclone-damoon.aws-ap-northeast-1.turso.io

# Put the real value in Render's environment variables. Never commit it.
TURSO_AUTH_TOKEN=replace-with-a-new-rotated-token

# Optional shared NPC activity interval. Production values below 60 are clamped.
XCLONE_NPC_INTERVAL_SECONDS=900

# This variable belongs on desktop clients, not on the Render backend.
XCLONE_SERVER_URL=https://YOUR-SERVICE.onrender.com

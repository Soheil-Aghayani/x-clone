<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #000000;" stylesheets="@../styles/twitter.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controllers.loginController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    <children>
        <!-- X Mock Text Logo -->
        <Label text="𝕏" textFill="WHITE">
            <font>
                <Font name="System Bold" size="50.0" />
            </font>
        </Label>

        <Label text="Sign in to 𝕏" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
        </Label>

        <!-- Input Fields -->
        <TextField fx:id="usernameField" minHeight="35.0" promptText="Username or email" style="-fx-background-color: #000000; -fx-text-inner-color: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-prompt-text-fill: #71767b;" />

        <PasswordField fx:id="passwordField" minHeight="35.0" promptText="Password" style="-fx-background-color: #000000; -fx-text-inner-color: white; -fx-border-color: #333333; -fx-border-radius: 5; -fx-prompt-text-fill: #71767b;" />

        <!-- Action Button -->
        <Button fx:id="loginButton" maxWidth="Infinity" minHeight="40.0" onAction="#handleLogin" style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-background-radius: 20; -fx-font-weight: bold;" text="Log In" />
        <Label text="Don't have an account?" textFill="#71767b">
            <font>
                <Font size="14.0" />
            </font>
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
        </Label>
        <Button fx:id="goToRegisterButton" onAction="#handleGoToRegister" style="-fx-background-color: transparent; -fx-text-fill: #1d9bf0; -fx-font-weight: bold; -fx-underline: true; -fx-cursor: hand;" text="Create account" />
    </children>
</VBox>

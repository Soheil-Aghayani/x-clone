<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="760.0" prefWidth="1280.0" styleClass="app-shell" stylesheets="@../styles/twitter.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.controllers.ProfileController">

    <VBox fx:id="leftSidebar" minWidth="270.0" prefWidth="270.0" maxWidth="270.0" spacing="2.0" styleClass="left-sidebar">
        <Button fx:id="brandLabel" onAction="#handleLogoHome" styleClass="brand-button" />
        <Button fx:id="homeNavButton" text="Home" maxWidth="Infinity" onAction="#handleGoToHome" styleClass="nav-button" />
        <Button fx:id="exploreNavButton" text="Explore" maxWidth="Infinity" onAction="#handleGoToExplore" styleClass="nav-button" />
        <Button fx:id="notificationsNavButton" text="Notifications" maxWidth="Infinity" onAction="#handleGoToNotifications" styleClass="nav-button" />
        <Button fx:id="chatNavButton" text="Chat" maxWidth="Infinity" onAction="#handleGoToChat" styleClass="nav-button" />
        <Button fx:id="bookmarksNavButton" text="Bookmarks" maxWidth="Infinity" onAction="#handleGoToBookmarks" styleClass="nav-button" />
        <Button fx:id="profileNavButton" text="Profile" maxWidth="Infinity" styleClass="nav-button, nav-button-active" />
        <Button fx:id="moreNavButton" text="More" maxWidth="Infinity" onAction="#handleGoToMore" styleClass="nav-button" />
        <Button fx:id="sidebarPostButton" text="Post" maxWidth="Infinity" onAction="#handleOpenPostComposer" styleClass="primary-post-button">
            <VBox.margin><Insets top="8.0" /></VBox.margin>
        </Button>
        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="account-card">
            <Label fx:id="sidebarAvatarLabel" minHeight="40.0" minWidth="40.0" prefHeight="40.0" prefWidth="40.0" styleClass="avatar-small" text="U" />
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="sidebarNameLabel" text="User" styleClass="widget-name" />
                <Label fx:id="sidebarUsernameLabel" text="@user" styleClass="secondary-text" />
            </VBox>
            <Button fx:id="accountMoreButton" onAction="#handleAccountMenu" styleClass="icon-button" />
        </HBox>
    </VBox>

    <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                HBox.hgrow="ALWAYS" styleClass="page-scroll">
        <content>
            <HBox minWidth="1010.0" prefWidth="1010.0" alignment="TOP_LEFT" styleClass="page-content">
    <VBox minWidth="600.0" prefWidth="600.0" maxWidth="600.0" styleClass="center-column">
        <HBox alignment="CENTER_LEFT" minHeight="54.0" prefHeight="54.0" spacing="14.0" styleClass="top-header">
            <Button fx:id="backButton" onAction="#handleGoToHome" styleClass="icon-button" />
            <VBox>
                <Label fx:id="headerNameLabel" text="User" styleClass="header-title" />
                <Label fx:id="postCountLabel" text="0 posts" styleClass="secondary-text" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="headerSearchButton" onAction="#handleFocusSearch" styleClass="icon-button" />
        </HBox>

                <VBox>
                    <StackPane minHeight="264.0" prefHeight="264.0" maxHeight="264.0">
                        <Region fx:id="profileBannerFallback" prefHeight="200.0" maxHeight="200.0" StackPane.alignment="TOP_CENTER" styleClass="profile-banner" />
                        <ImageView fx:id="profileBannerImage" fitWidth="600.0" fitHeight="200.0" preserveRatio="false" visible="false" managed="false" StackPane.alignment="TOP_CENTER" />
                        <Circle fx:id="profileAvatarCircle" radius="66.0" translateX="16.0" translateY="1.0" StackPane.alignment="BOTTOM_LEFT" styleClass="profile-avatar" />
                        <Label fx:id="profileAvatarLabel" minWidth="132.0" alignment="CENTER" text="U" translateX="16.0" translateY="1.0" StackPane.alignment="BOTTOM_LEFT" style="-fx-text-fill: white; -fx-font-size: 30; -fx-font-weight: bold;" />
                        <HBox fx:id="profileActionBar" alignment="CENTER_RIGHT" minHeight="48.0" prefHeight="48.0" maxHeight="48.0"
                              spacing="8.0" translateX="-16.0" StackPane.alignment="BOTTOM_RIGHT">
                            <Button fx:id="profileMessageButton" managed="false" visible="false" onAction="#handleGoToChat" styleClass="profile-round-action" />
                            <Button fx:id="editProfileButton" text="Edit profile" onAction="#handleEditProfile" styleClass="edit-profile-button" />
                        </HBox>
                    </StackPane>

                    <VBox spacing="8.0" styleClass="profile-details">
                        <VBox spacing="1.0">
                            <Label fx:id="nameLabel" text="User" styleClass="profile-name" />
                            <Label fx:id="usernameLabel" text="@user" styleClass="secondary-text" />
                        </VBox>
                        <Label fx:id="bioLabel" text="No bio available" wrapText="true" styleClass="profile-bio" />
                        <Label fx:id="parodyMetaLabel" text="Parody account" managed="false" visible="false" styleClass="secondary-text" />
                        <HBox spacing="16.0">
                            <Label fx:id="locationMetaLabel" text="Tehran" styleClass="secondary-text" />
                            <Label fx:id="linkMetaLabel" text="your.site" styleClass="show-more" />
                            <Label fx:id="calendarMetaLabel" text="Joined July 2026" styleClass="secondary-text" />
                        </HBox>
                        <HBox spacing="20.0">
                            <HBox fx:id="followingStat" spacing="4.0" onMouseClicked="#handleFollowingList" styleClass="profile-stat-link"><Label fx:id="followingCountLabel" text="0" styleClass="profile-stat-number" /><Label text="Following" styleClass="secondary-text" /></HBox>
                            <HBox fx:id="followersStat" spacing="4.0" onMouseClicked="#handleFollowersList" styleClass="profile-stat-link"><Label fx:id="followerCountLabel" text="0" styleClass="profile-stat-number" /><Label text="Followers" styleClass="secondary-text" /></HBox>
                        </HBox>
                    </VBox>

                    <HBox alignment="CENTER" styleClass="profile-tabs">
                        <Button fx:id="postsTabButton" text="Posts" onAction="#handlePostsTab" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tab-button, tab-button-active" />
                        <Button fx:id="repliesTabButton" text="Replies" onAction="#handleRepliesTab" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tab-button" />
                        <Button fx:id="highlightsTabButton" text="Highlights" onAction="#handleEmptyTab" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tab-button" />
                        <Button fx:id="articlesTabButton" text="Articles" onAction="#handleEmptyTab" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tab-button" />
                        <Button fx:id="mediaTabButton" text="Media" onAction="#handleMediaTab" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tab-button" />
                        <Button fx:id="likesTabButton" text="Likes" onAction="#handleLikesTab" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="tab-button" />
                    </HBox>

                    <VBox fx:id="userTweetsContainer" />
                </VBox>
    </VBox>

    <VBox fx:id="rightSidebar" minWidth="380.0" prefWidth="380.0" maxWidth="410.0" spacing="14.0" HBox.hgrow="ALWAYS" styleClass="right-sidebar">
        <TextField fx:id="profileSearchField" promptText="Search" onAction="#handleSearch" styleClass="search-field" />

        <VBox fx:id="profileSuggestionsWidget" spacing="14.0" styleClass="widget-card" />

        <VBox spacing="15.0" styleClass="widget-card">
            <Label text="What's happening" styleClass="widget-title" />
            <VBox><Label text="Technology · Trending" styleClass="secondary-text" /><Label text="#JavaFX" styleClass="widget-name" /><Label text="12.8K posts" styleClass="secondary-text" /></VBox>
            <VBox><Label text="Trending" styleClass="secondary-text" /><Label text="#Design" styleClass="widget-name" /><Label text="8,420 posts" styleClass="secondary-text" /></VBox>
            <VBox><Label text="Software · Trending" styleClass="secondary-text" /><Label text="Desktop apps" styleClass="widget-name" /><Label text="4,218 posts" styleClass="secondary-text" /></VBox>
            <Label text="Show more" styleClass="show-more" />
        </VBox>
    </VBox>
            </HBox>
        </content>
    </ScrollPane>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="700.0" prefWidth="600.0" style="-fx-background-color: #000000;" styleClass="auth-shell"
           stylesheets="@../styles/twitter.css"
           xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="client.controllers.LoginController">
    <VBox alignment="TOP_LEFT" maxWidth="440.0" prefWidth="440.0" spacing="18.0" styleClass="auth-card">
        <padding><Insets bottom="44.0" left="44.0" right="44.0" top="28.0" /></padding>

        <HBox alignment="CENTER" minHeight="42.0">
            <Label fx:id="authLogo" styleClass="auth-logo" />
        </HBox>

        <Label text="Sign in to X" styleClass="auth-title" />



        <TextField fx:id="usernameField" promptText="Phone, email, or username" maxWidth="Infinity"
                   onAction="#focusPassword" styleClass="auth-field" />
        <StackPane maxWidth="Infinity">
            <PasswordField fx:id="passwordField" promptText="Password" maxWidth="Infinity"
                           onAction="#handleLogin" styleClass="auth-field,password-entry" />
            <TextField fx:id="visiblePasswordField" promptText="Password" maxWidth="Infinity"
                       visible="false" managed="false" onAction="#handleLogin"
                       styleClass="auth-field,password-entry" />
            <Button fx:id="passwordVisibilityButton" onAction="#togglePasswordVisibility"
                    StackPane.alignment="CENTER_RIGHT" styleClass="password-visibility-button">
                <StackPane.margin><Insets right="11.0" /></StackPane.margin>
            </Button>
        </StackPane>

        <Button fx:id="loginButton" text="Sign in" maxWidth="Infinity" onAction="#handleLogin"
                styleClass="auth-primary-button" />
        <Button text="Forgot password?" maxWidth="Infinity" onAction="#handleForgotPassword"
                styleClass="auth-secondary-button" />

        <Label fx:id="errorLabel" minHeight="34.0" maxWidth="Infinity" wrapText="true" styleClass="auth-error" />

        <HBox alignment="CENTER_LEFT" spacing="4.0">
            <Label text="Don't have an account?" styleClass="auth-muted" />
            <Button fx:id="goToRegisterButton" text="Sign up" onAction="#handleGoToRegister" styleClass="auth-link-button" />
        </HBox>
    </VBox>
</StackPane>

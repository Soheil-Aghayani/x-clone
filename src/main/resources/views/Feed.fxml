<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.shape.Circle?>

<HBox prefHeight="760.0" prefWidth="1280.0" styleClass="app-shell" stylesheets="@../styles/twitter.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.controllers.FeedController">

    <VBox fx:id="leftSidebar" minWidth="270.0" prefWidth="270.0" maxWidth="270.0" spacing="2.0" styleClass="left-sidebar">
        <Button fx:id="brandLabel" onAction="#handleLogoHome" styleClass="brand-button" />
        <Button fx:id="homeNavButton" text="Home" maxWidth="Infinity" onAction="#handleShowHome" styleClass="nav-button, nav-button-active" />
        <Button fx:id="exploreNavButton" text="Explore" maxWidth="Infinity" onAction="#handleShowExplore" styleClass="nav-button" />
        <Button fx:id="notificationsNavButton" text="Notifications" maxWidth="Infinity" onAction="#handleShowNotifications" styleClass="nav-button" />
        <Button fx:id="chatNavButton" text="Chat" maxWidth="Infinity" onAction="#handleShowChat" styleClass="nav-button" />
        <Button fx:id="bookmarksNavButton" text="Bookmarks" maxWidth="Infinity" onAction="#handleShowBookmarks" styleClass="nav-button" />
        <Button fx:id="profileNavButton" text="Profile" maxWidth="Infinity" onAction="#handleGoToProfile" styleClass="nav-button" />
        <Button fx:id="moreNavButton" text="More" maxWidth="Infinity" onAction="#handleMoreMenu" styleClass="nav-button" />
        <Button fx:id="sidebarPostButton" text="Post" maxWidth="Infinity" onAction="#handleOpenPostComposer" styleClass="primary-post-button">
            <VBox.margin><Insets top="8.0" /></VBox.margin>
        </Button>
        <Region VBox.vgrow="ALWAYS" />
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="account-card">
            <Label fx:id="sidebarAvatarLabel" minHeight="40.0" minWidth="40.0" prefHeight="40.0" prefWidth="40.0" styleClass="avatar-small" text="U" />
            <VBox HBox.hgrow="ALWAYS">
                <Label fx:id="sidebarNameLabel" text="User" styleClass="widget-name" />
                <Label fx:id="sidebarUsernameLabel" text="@user" styleClass="secondary-text" />
            </VBox>
            <Button fx:id="accountMoreButton" onAction="#handleAccountMenu" styleClass="icon-button" />
        </HBox>
    </VBox>

    <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                HBox.hgrow="ALWAYS" styleClass="page-scroll">
        <content>
            <HBox minWidth="1010.0" prefWidth="1010.0" alignment="TOP_LEFT" styleClass="page-content">
    <VBox fx:id="centerColumn" minWidth="600.0" prefWidth="600.0" maxWidth="600.0" HBox.hgrow="ALWAYS" styleClass="center-column">
        <HBox fx:id="topHeader" alignment="CENTER_LEFT" minHeight="54.0" prefHeight="54.0" styleClass="top-header">
            <Label fx:id="headerTitleLabel" text="Home" styleClass="header-title" />
            <TextField fx:id="centerSearchField" managed="false" visible="false" promptText="Search" HBox.hgrow="ALWAYS" styleClass="search-field" />
            <Region fx:id="headerSpacer" HBox.hgrow="ALWAYS" />
            <Button fx:id="headerFilterButton" styleClass="icon-button" />
        </HBox>

        <HBox fx:id="composerSection" spacing="12.0" styleClass="composer">
            <Label fx:id="composerAvatarLabel" minHeight="44.0" minWidth="44.0" prefHeight="44.0" prefWidth="44.0" styleClass="composer-avatar" text="U" />
            <VBox HBox.hgrow="ALWAYS">
                <TextArea fx:id="tweetTextArea" minHeight="68.0" prefHeight="68.0" maxHeight="360.0" promptText="What is happening?!" styleClass="tweet-area" wrapText="true" />
                <HBox fx:id="attachmentBar" alignment="CENTER_LEFT" managed="false" visible="false" style="-fx-background-color: #eff3f4; -fx-background-radius: 12; -fx-padding: 8 10;">
                    <Label fx:id="attachmentLabel" text="Attached image" HBox.hgrow="ALWAYS" styleClass="secondary-text" />
                    <Button text="×" onAction="#handleRemoveAttachment" styleClass="icon-button" />
                </HBox>
                <HBox alignment="CENTER_LEFT" styleClass="composer-toolbar">
                    <Button fx:id="imageButton" onAction="#handleChooseImage" styleClass="tool-icon" />
                    <Button fx:id="gifButton" onAction="#handleChooseGif" styleClass="tool-icon" />
                    <Button fx:id="pollButton" onAction="#handleCreatePoll" styleClass="tool-icon" />
                    <Button fx:id="ideaButton" onAction="#handleWritingIdeas" styleClass="tool-icon" />
                    <Button fx:id="locationButton" onAction="#handleAddLocation" styleClass="tool-icon" />
                    <Region HBox.hgrow="ALWAYS" />
                    <StackPane fx:id="characterCounterStack" managed="false" visible="false" styleClass="character-counter-stack">
                        <Circle fx:id="characterProgress" radius="15.0" fill="TRANSPARENT" stroke="#fddd3e" strokeWidth="2.0" styleClass="character-progress" />
                        <Label fx:id="characterCountLabel" text="20" styleClass="character-count" />
                    </StackPane>
                    <Button fx:id="postButton" disable="true" text="Post" onAction="#handlePostTweet" styleClass="composer-post-button">
                        <HBox.margin><Insets left="8.0" /></HBox.margin>
                    </Button>
                </HBox>
            </VBox>
        </HBox>

        <VBox fx:id="timelineContainer" />
    </VBox>

    <VBox fx:id="rightSidebar" minWidth="380.0" prefWidth="380.0" maxWidth="410.0" spacing="14.0" styleClass="right-sidebar">
        <TextField fx:id="searchField" promptText="Search" styleClass="search-field" />

        <VBox fx:id="suggestionWidget" spacing="14.0" styleClass="widget-card">
            <Label text="You might like" styleClass="widget-title" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="J" minWidth="40.0" minHeight="40.0" styleClass="avatar-small" />
                <VBox HBox.hgrow="ALWAYS"><Label text="JavaFX" styleClass="widget-name" /><Label text=" @openjfx" styleClass="secondary-text" /></VBox>
                <Button fx:id="followJavaFxButton" text="Follow" onAction="#handleFollowJavaFx" styleClass="follow-button" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="D" minWidth="40.0" minHeight="40.0" styleClass="avatar-small" />
                <VBox HBox.hgrow="ALWAYS"><Label text="Design Daily" styleClass="widget-name" /><Label text=" @designdaily" styleClass="secondary-text" /></VBox>
                <Button fx:id="followDesignButton" text="Follow" onAction="#handleFollowDesign" styleClass="follow-button" />
            </HBox>
            <Label text="Show more" styleClass="show-more" />
        </VBox>

        <VBox fx:id="trendsWidget" spacing="15.0" styleClass="widget-card">
            <Label text="What's happening" styleClass="widget-title" />
            <VBox><Label text="Technology · Trending" styleClass="secondary-text" /><Label text="#JavaFX" styleClass="widget-name" /><Label text="12.8K posts" styleClass="secondary-text" /></VBox>
            <VBox><Label text="Trending" styleClass="secondary-text" /><Label text="#Design" styleClass="widget-name" /><Label text="8,420 posts" styleClass="secondary-text" /></VBox>
            <VBox><Label text="Software · Trending" styleClass="secondary-text" /><Label text="Desktop apps" styleClass="widget-name" /><Label text="4,218 posts" styleClass="secondary-text" /></VBox>
            <Label text="Show more" styleClass="show-more" />
        </VBox>
    </VBox>
            </HBox>
        </content>
    </ScrollPane>
</HBox>
